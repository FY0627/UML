# ==============================================================================
# LingoFlow Environment Configuration Template (.env.example)
# Rename this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Database Settings
MYSQL_ROOT_PASSWORD=your_mysql_root_password
MYSQL_DATABASE=lingo_db

# Spring AI Configuration (SiliconFlow / OpenAI API)
# Get your API key from siliconflow.cn or openai.com
SPRING_AI_OPENAI_API_KEY=your_openai_or_siliconflow_api_key
SPRING_AI_OPENAI_BASE_URL=https://api.siliconflow.cn
